generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int      @id @default(autoincrement())
  name        String?
  email       String   @unique
  password    String
  phonenumber String?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  role        Role     @default(EMPLOYED)
  photo       String?
  absen       Absen[]
}

model Absen {
  id          Int         @id @default(autoincrement())
  userId      Int
  tanggal     DateTime    @default(now())
  jamMasuk    DateTime?
  jamKeluar   DateTime?
  latitude    Float
  longitude   Float
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  statusAbsen StatusAbsen @default(HADIR)
  user        User        @relation(fields: [userId], references: [id])
}

enum StatusAbsen {
  HADIR
  IZIN
  TERLAMBAT
}

enum Role {
  ADMIN
  EMPLOYED
}
